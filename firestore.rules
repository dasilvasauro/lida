rules_version = '2';

// Regras do Lida — cofre v2.
// Publique ANTES de colocar a nova versão do app no ar
// (Firebase Console > Firestore Database > Regras > colar > Publicar).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Documento antigo (cofre v1). Continua legível (é o backup da migração).
      // Só aceita gravações enquanto o cofre novo ainda não existe: assim uma
      // versão antiga do app, ainda aberta em algum aparelho, não sobrescreve nada
      // depois da migração.
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/users/$(uid)/vault/_meta);

      // Cofre novo (v2): _meta + pedaços criptografados.
      match /vault/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
