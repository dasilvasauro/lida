<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Adição rápida": o botão + abre uma janelinha para anotar uma tarefa (sem abrir o app) e
     a lista mostra as tarefas de hoje, cada uma com o círculo de concluir. Só componentes aceitos por
     RemoteViews (LinearLayout, TextView, ProgressBar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/q_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/q_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_today"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/q_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/q_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_add_btn"
            android:contentDescription="@string/quick_add"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_on_accent"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/q_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:id="@+id/q_row0"
        style="@style/QuickRow">
        <TextView android:id="@+id/q_chk0" style="@style/QuickCheck" />
        <TextView android:id="@+id/q_txt0" style="@style/QuickText" />
        <TextView android:id="@+id/q_time0" style="@style/QuickTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/q_row1"
        style="@style/QuickRow">
        <TextView android:id="@+id/q_chk1" style="@style/QuickCheck" />
        <TextView android:id="@+id/q_txt1" style="@style/QuickText" />
        <TextView android:id="@+id/q_time1" style="@style/QuickTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/q_row2"
        style="@style/QuickRow">
        <TextView android:id="@+id/q_chk2" style="@style/QuickCheck" />
        <TextView android:id="@+id/q_txt2" style="@style/QuickText" />
        <TextView android:id="@+id/q_time2" style="@style/QuickTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/q_row3"
        style="@style/QuickRow">
        <TextView android:id="@+id/q_chk3" style="@style/QuickCheck" />
        <TextView android:id="@+id/q_txt3" style="@style/QuickText" />
        <TextView android:id="@+id/q_time3" style="@style/QuickTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/q_row4"
        style="@style/QuickRow">
        <TextView android:id="@+id/q_chk4" style="@style/QuickCheck" />
        <TextView android:id="@+id/q_txt4" style="@style/QuickText" />
        <TextView android:id="@+id/q_time4" style="@style/QuickTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/q_row5"
        style="@style/QuickRow">
        <TextView android:id="@+id/q_chk5" style="@style/QuickCheck" />
        <TextView android:id="@+id/q_txt5" style="@style/QuickText" />
        <TextView android:id="@+id/q_time5" style="@style/QuickTime" />
    </LinearLayout>

    <TextView
        android:id="@+id/q_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/quick_empty"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/q_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
